{
  "name": "tree-todo-list",
  "displayName": "Tree Todo List",
  "description": "A simple extension for managing Todo items as a tree view",
  "private": true,
  "version": "0.0.3",
  "license": "GPL-3.0",
  "publisher": "RaphKa02",
  "keywords": [
    "todo",
    "list",
    "tree",
    "todo list tree",
    "task",
    "tasklist"
  ],
  "author": {
    "email": "it@karl-raphael.de",
    "name": "Raphael Karl"
  },
  "readme": "./README.md",
  "icon": "images/logo.png",
  "categories": [
    "Visualization"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "tree-todo-list.editor",
        "displayName": "Tree Todo List",
        "selector": [
          {
            "filenamePattern": "*.treetodo"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "tree-todo-list.newTreeTodo",
        "title": "New Tree ToDo List",
        "category": "TreeToDo"
      },
      {
        "command": "tree-todo-list.viewSource",
        "title": "View Source",
        "icon": "$(code)",
        "category": "TreeToDo"
      },
      {
        "command": "tree-todo-list.viewCustomEditor",
        "title": "Open Editor",
        "icon": "$(preview)",
        "category": "TreeToDo"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tree-todo-list.viewSource",
          "when": "activeCustomEditorId == 'tree-todo-list.editor'",
          "group": "navigation"
        },
        {
          "command": "tree-todo-list.viewCustomEditor",
          "when": "resourceExtname == '.treetodo' && activeCustomEditorId != 'tree-todo-list.editor'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Tree ToDo List",
      "properties": {
        "tree-todo-list.maxPasses": {
          "type": "integer",
          "default": 10,
          "description": "Maximum number of iterations to perform during state updates to resolve cascading changes."
        },
        "tree-todo-list.autoReorderTasks": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reorder tasks to match the order of items in their parent tasks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}