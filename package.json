{
  "name": "tree-todo-list",
  "displayName": "Tree Todo List",
  "description": "A simple extension for managing Todo items as a tree view",
  "private": true,
  "version": "0.0.1",
	"license": "GPL-3.0",  
  "publisher": "RaphKa02",
	"keywords": [
		"todo",
    "list",
    "tree",
    "todo list tree",
    "task",
    "tasklist"
	],
	"author": {
		"email": "it@karl-raphael.de",
		"name": "Raphael Karl"
	},
	"readme": "./README.md",
	"icon": "images/logo.png",
  "categories": [
    "Visualization"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
  "contributes": {
    "customEditors": [
      {
        "viewType": "tree-todo-list.editor",
        "displayName": "Tree Todo List",
        "selector": [
          {
            "filenamePattern": "*.treetodo"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "tree-todo-list.newTreeTodo",
        "title": "New Tree ToDo List"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
