{
  "name": "tree-todo-list",
  "displayName": "Tree Todo List",
  "description": "A simple extension for managing Todo items as a tree view",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0",
  "publisher": "RaphKa02",
  "keywords": [
    "todo",
    "list",
    "tree",
    "todo list tree",
    "task",
    "tasklist"
  ],
  "author": {
    "email": "it@karl-raphael.de",
    "name": "Raphael Karl"
  },
  "readme": "./README.md",
  "icon": "images/logo.png",
  "categories": [
    "Visualization"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "repository": {
    "url": "https://github.com/RaphKa02/tree-todo-list.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "treetodo",
        "aliases": [
          "Tree Todo",
          "treetodo"
        ],
        "extensions": [
          ".treetodo"
        ],
        "icon": {
          "light": "images/treetodo-icon.svg",
          "dark": "images/treetodo-icon.svg"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "tree-todo-list.editor",
        "displayName": "Tree Todo List",
        "selector": [
          {
            "filenamePattern": "*.treetodo"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "tree-todo-list.newTreeTodo",
        "title": "New Tree Todo List",
        "category": "TreeTodo"
      },
      {
        "command": "tree-todo-list.importJson",
        "title": "Import JSON from treetodolist.com",
        "category": "TreeTodo"
      },
      {
        "command": "tree-todo-list.viewSource",
        "title": "View Source",
        "icon": "$(code)",
        "category": "TreeTodo"
      },
      {
        "command": "tree-todo-list.viewCustomEditor",
        "title": "Open Editor",
        "icon": "$(preview)",
        "category": "TreeTodo"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tree-todo-list.viewSource",
          "when": "activeCustomEditorId == 'tree-todo-list.editor'",
          "group": "navigation"
        },
        {
          "command": "tree-todo-list.viewCustomEditor",
          "when": "resourceExtname == '.treetodo' && activeCustomEditorId != 'tree-todo-list.editor'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Tree Todo List",
      "properties": {
        "tree-todo-list.maxPasses": {
          "type": "integer",
          "default": 10,
          "description": "Maximum number of iterations to perform during state updates to resolve cascading changes."
        },
        "tree-todo-list.autoReorderTasks": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reorder tasks to match the order of items in their parent tasks."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "format": "prettier --write .",
    "lint:format": "prettier --check .",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
